# secrets - never commit any of these
.env
*.key
*.pem
*.p12

# python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# node (kept out of this repo by design - the install path is /plugin install)
node_modules/

# logs and reports
*.log
charts/*.bak
state/
.cache/

# runtime-generated per-index data (produced by scripts on each rebalance)
# catalog and seeded positions stay committed; only dynamic outputs are ignored:
data/tracking/*
!data/tracking/example-index.json
!data/tracking/.gitkeep
data/positions/*.last_fill_ts
data/positions/*.series.json
# advisor plans (generated by the improve skill, not shipped)
plans/

# editor / OS
.DS_Store
.idea/
.vscode/