# secrets - never commit any of these
.env
*.key
*.pem
*.p12

# python
__pycache__/
*.pyc
.venv/
venv/

# node (kept out of this repo by design - the install path is /plugin install)
node_modules/

# logs and reports
*.log
charts/*.bak
state/
.cache/

# runtime-generated per-index data (produced by scripts on each rebalance)
# catalog and seeded positions stay committed; only dynamic outputs are ignored:
plugins/adjacent/data/tracking/*
!plugins/adjacent/data/tracking/example-index.json
!plugins/adjacent/data/tracking/.gitkeep
plugins/adjacent/data/positions/*.last_fill_ts
plugins/adjacent/data/positions/*.series.json
# editor / OS
.DS_Store
.idea/
.vscode/
